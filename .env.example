# BigCommerce API Configuration
# Get your API token from BigCommerce: Store Settings > API > Store-level API Accounts

# Your BigCommerce API URL (replace {store_hash} with your actual store hash)
BIGCOMMERCE_API_URL=https://api.bigcommerce.com/stores/{store_hash}/v3

# Your BigCommerce API Token
BIGCOMMERCE_TOKEN=your_api_token_here

# Frontend Configuration
# Backend API URL (defaults to http://localhost:3001/api if not set)
VITE_API_BASE_URL=http://localhost:3001/api

# Clerk Authentication
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Magento (Adobe Commerce) API Configuration
# Get your token from Magento: Admin > System > Integrations > Add New Integration

# Magento API Base URL
MAGENTO_API_URL=https://qa-psp-mage.tryzens-ignite.com

# Magento Bearer Token
MAGENTO_TOKEN=eyJraWQiOiIxIiwiYWxnIjoiSFMyNTYifQ.eyJ1aWQiOjksInV0eXBpZCI6MiwiaWF0IjoxNzYzMTg1MTQ2LCJleHAiOjE3NjMxODg3NDZ9.mOp4vCjwQU4HhxonCEG8QkLnkLTneDRPbWQ-daakx1I

# n8n Webhook Configuration
# URL for n8n smart offers webhook
N8N_WEBHOOK_URL=https://tryzens-ai.app.n8n.cloud/webhook-test/getSmartOffers
N8N_API_KEY=test@123

# MongoDB Atlas Configuration
# Get your connection string from MongoDB Atlas: Database > Connect > Connect your application
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/your_database_name?retryWrites=true&w=majority

# Encryption Key for sensitive data (API keys, secrets)
# Generate a secure 64-character hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_string_here
